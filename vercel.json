{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/facturen/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/facturen", "destination": "/index.html" },
    { "source": "/facturen/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
